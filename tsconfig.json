{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strict": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"outDir": "./dist"
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
