{
	"name": "obsidian-pdf-intake",
	"version": "0.2.0",
	"description": "Resolve bibliographic metadata and safely rename PDFs in Obsidian",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/nonselection/obsidian-pdf-intake.git"
	},
	"homepage": "https://github.com/nonselection/obsidian-pdf-intake#readme",
	"bugs": {
		"url": "https://github.com/nonselection/obsidian-pdf-intake/issues"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
		"deploy": "npm run build && node scripts/deploy.mjs dev",
		"deploy:actual": "npm run build && node scripts/deploy.mjs actual"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"pdf",
		"metadata"
	],
	"author": "Sofia Mavzalevskaya",
	"license": "MIT",
	"dependencies": {
		"pdfjs-dist": "^4.0.379"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.4",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.0",
		"eslint": "^10.11.0",
		"obsidian": "latest",
		"prettier": "^3.9.9",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.70.1",
		"vitest": "^3.2.7"
	}
}
